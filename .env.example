# Nova Backend Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Administrator Email (Where grievances will be sent)
ADMIN_EMAIL=nova0hero@gmail.com
ADMIN_TIMEZONE=Asia/Kolkata

# Nodemailer / Gmail App Password (16 characters without spaces)
EMAIL_APP_PASSWORD=your_16_character_app_password_here

# Server Port
PORT=3001

# OpenRouter GPT-4o Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_REFERER=https://nova-nu-nine.vercel.app
OPENROUTER_TITLE=Nova

