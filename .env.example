# ==========================================================
# NOVA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this to .env or add these to your production host (Vercel / Render)
# ==========================================================

# 1. EMAIL & NODEMAILER (MANDATORY FOR SOS SIGNALS & COPY EMAILS)
# ----------------------------------------------------------
# The email where the Hero receives original SOS alerts, and the sender for copy emails
ADMIN_EMAIL=your_email@gmail.com
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (generated at https://myaccount.google.com/apppasswords)
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_PASS=your_16_char_app_password

# Timezone for transmission timestamps
ADMIN_TIMEZONE=Asia/Kolkata

# 2. OPENROUTER AI ENGINE (FOR NOVA'S CONVERSATION & CHAT)
# ----------------------------------------------------------
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model configuration
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_REFERER=https://your-site.vercel.app
OPENROUTER_TITLE=Nova

# 3. OPTIONAL AI FALLBACKS & SYSTEM
# ----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
